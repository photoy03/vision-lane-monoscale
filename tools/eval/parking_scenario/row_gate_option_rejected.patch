diff --git a/src/parking/parking_scenario/parking_scenario/slot_logic.py b/src/parking/parking_scenario/parking_scenario/slot_logic.py
index 390760b..9f3ecaa 100644
--- a/src/parking/parking_scenario/parking_scenario/slot_logic.py
+++ b/src/parking/parking_scenario/parking_scenario/slot_logic.py
@@ -117,6 +117,58 @@ def duplicates(slots: dict) -> set:
     return hidden
 
 
+def off_grid(slots: dict, tolerance: float, min_row: int = 4) -> set:
+    """IDs of confirmed slots that do not sit on the regular grid of their row.
+
+    Slots of one row (similar direction, entrances on one line) are spaced by a whole number of slot
+    pitches. The pitch (2.2 .. 2.8 m) and the phase that put the most slots within `tolerance` are taken
+    as the row's grid when they hold at least min_row slots and 60 % of the row; the others are off the
+    grid (a rectangle built on a wrong line sits half a metre beside its place). Rows with fewer than
+    min_row slots are not judged."""
+    ids = [k for k, v in slots.items() if v["confirmed"]]
+    parent = {k: k for k in ids}
+
+    def find(k):
+        while parent[k] != k:
+            parent[k] = parent[parent[k]]
+            k = parent[k]
+        return k
+
+    centre = {k: (slots[k]["entrance"][0] + 0.5 * slots[k]["depth"] * math.cos(slots[k]["yaw"]),
+                  slots[k]["entrance"][1] + 0.5 * slots[k]["depth"] * math.sin(slots[k]["yaw"])) for k in ids}
+    for n, a in enumerate(ids):
+        ca, sa = math.cos(slots[a]["yaw"]), math.sin(slots[a]["yaw"])
+        for b in ids[n + 1:]:
+            turn = slots[b]["yaw"] - slots[a]["yaw"]
+            if abs(math.atan2(math.sin(turn), math.cos(turn))) > math.radians(10.0):
+                continue
+            dx, dy = centre[b][0] - centre[a][0], centre[b][1] - centre[a][1]
+            if abs(ca * dx + sa * dy) <= 1.0 and abs(-sa * dx + ca * dy) <= 8.0:
+                parent[find(a)] = find(b)
+    rows: dict = {}
+    for k in ids:
+        rows.setdefault(find(k), []).append(k)
+    out = set()
+    for members in rows.values():
+        if len(members) < min_row:
+            continue
+        yaws = sorted(slots[members[0]]["yaw"] + math.atan2(math.sin(slots[k]["yaw"] - slots[members[0]]["yaw"]),
+                                                             math.cos(slots[k]["yaw"] - slots[members[0]]["yaw"])) for k in members)
+        yaw = yaws[len(yaws) // 2]
+        v = np.array([-math.sin(yaw) * centre[k][0] + math.cos(yaw) * centre[k][1] for k in members])
+        best = None
+        for pitch in np.arange(2.20, 2.801, 0.01):
+            for phase in v:
+                r = (v - phase + 0.5 * pitch) % pitch - 0.5 * pitch
+                inside = np.abs(r) <= tolerance
+                score = (int(inside.sum()), -float(np.abs(r[inside]).sum()))
+                if best is None or score > best[0]:
+                    best = (score, inside)
+        if best[0][0] >= max(min_row, math.ceil(0.6 * len(members))):
+            out.update(k for k, ok in zip(members, best[1]) if not ok)
+    return out
+
+
 class OccupancyState:
     """Per-slot temporal rule: OCCUPIED after 1, FREE after n in a row, UNKNOWN at once."""
 
