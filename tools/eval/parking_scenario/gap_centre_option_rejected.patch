diff --git a/src/parking/parking_scenario/parking_scenario/slot_logic.py b/src/parking/parking_scenario/parking_scenario/slot_logic.py
index 390760b..9082f8d 100644
--- a/src/parking/parking_scenario/parking_scenario/slot_logic.py
+++ b/src/parking/parking_scenario/parking_scenario/slot_logic.py
@@ -98,6 +98,37 @@ def body_clear(grid, origin, res, pose, vehicle, margin=0.20, occupied_value=70)
     return not bool((grid[rows[ok], cols[ok]] >= occupied_value).any())
 
 
+def gap_centre_shift(grid, origin, res, entrance, yaw, width, depth, vehicle, search: float = 1.5,
+                     max_shift: float = 1.0, min_cells: int = 4, occupied_value: int = 70):
+    """Sideways shift (m, + = left of the slot axis) that puts the slot axis in the middle of the free
+    gap between the LiDAR obstacles on both sides (parked cars), or 0.0.
+
+    A slot between two parked cars is often the only rectangle seen there and its painted lines are
+    half hidden, so the vision rectangle can sit most of a metre off; the cars themselves show where
+    the gap is. Used only when obstacles stand on BOTH sides within `search` of the slot's edges, the
+    gap is wide enough for the body plus 0.3 m a side, and the shift is at most max_shift."""
+    c, s = math.cos(yaw), math.sin(yaw)
+    reach = 0.5 * width + search
+    u = np.arange(0.8, max(0.9, depth - 0.5), res)                 # along the depth, away from the entrance line
+    v = np.arange(-reach, reach + 1e-6, res)
+    uu, vv = np.meshgrid(u, v)
+    cols = np.floor((entrance[0] + c * uu - s * vv - origin[0]) / res).astype(int)
+    rows = np.floor((entrance[1] + s * uu + c * vv - origin[1]) / res).astype(int)
+    ok = (rows >= 0) & (rows < grid.shape[0]) & (cols >= 0) & (cols < grid.shape[1])
+    hit = np.zeros(uu.shape, dtype=bool)
+    hit[ok] = grid[rows[ok], cols[ok]] >= occupied_value
+    per_v = hit.sum(axis=1)                                         # obstacle cells at each sideways offset
+    left = [float(x) for x, n in zip(v, per_v) if x > 0.0 and n >= min_cells]
+    right = [float(x) for x, n in zip(v, per_v) if x < 0.0 and n >= min_cells]
+    if not left or not right:
+        return 0.0
+    edge_left, edge_right = min(left), max(right)
+    if edge_left - edge_right < vehicle.width + 0.6:
+        return 0.0
+    shift = 0.5 * (edge_left + edge_right)
+    return shift if abs(shift) <= max_shift else 0.0
+
+
 def duplicates(slots: dict) -> set:
