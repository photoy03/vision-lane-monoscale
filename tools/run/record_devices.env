# Devices for tools/run/record_vehicle.sh (sourced by bash; arguments override).
# Camera names: ls /dev/v4l/by-id/ with the cameras plugged in (use the ...-video-index0 entries).
FRONT=
REAR=
# IMU: a WIT driver started separately publishes this topic (relayed to /sensing/imu/imu_data).
# For the F9R instead: IMU=/dev/serial/by-id/<f9r>-if00 and IMU_TOPIC= (empty).
IMU=
IMU_TOPIC=/imu_data
WIDTH=1920
HEIGHT=1080
FPS=30
# Session folder: <YYYYmmdd_HHMMSS>_<TRIAL>
TRIAL=drive
