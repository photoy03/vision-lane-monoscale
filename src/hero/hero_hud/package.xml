<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hero_hud</name>
  <version>0.1.0</version>
  <description>
    HERO 윈드실드 HUD — 표시 계약과 렌더러.
    저시력 운전자용 주차 코칭 표시 계층. 차량 제어 개입 없음.
    설계 근거는 docs/HUD_전략.md.
  </description>
  <maintainer email="ujin@tukorea.ac.kr">권우진</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>vision_lane_interfaces</depend>
  <depend>ament_index_cpp</depend>

  <!-- Qt5 Quick 씬그래프. QML 런타임 모듈은 쓰지 않는다 (docs/HUD_전략.md 8절). -->
  <depend>qtbase5-dev</depend>
  <depend>qtdeclarative5-dev</depend>
  <depend>libqt5svg5-dev</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
