<?xml version="1.0"?>
<package format="3">
  <name>hero_coach</name>
  <version>0.1.0</version>
  <description>
    hero_hud 의 상류. CARLA 차량 상태, monoscale 오도메트리·점유격자, Autoware A*
    계획을 HUD 표시 계약으로 바꾼다. 설계 근거는 docs/설계.md.
  </description>
  <maintainer email="ujin@tukorea.ac.kr">권우진</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>hero_hud</exec_depend>
  <exec_depend>autoware_vehicle_msgs</exec_depend>
  <exec_depend>autoware_planning_msgs</exec_depend>
  <exec_depend>autoware_freespace_planning_algorithms</exec_depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
