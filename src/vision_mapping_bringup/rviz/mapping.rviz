Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 28; 28; 28
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground grid
      Enabled: true
      Cell Size: 1
      Plane: XY
      Color: 80; 80; 80
      Alpha: 0.20
    - Class: rviz_default_plugins/Map
      Name: MonoScale occupancy
      Enabled: true
      Topic:
        Value: /perception/occupancy_grid_map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Alpha: 0.85
      Color Scheme: map
    - Class: rviz_default_plugins/MarkerArray
      Name: Lane vectors
      Enabled: true
      Topic:
        Value: /parking/cpp/global_marking_markers
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Image
      Name: Fused map (time-matched)
      Enabled: true
      Topic:
        Value: /mapping/fused_map/image
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Pose
      Name: Parking goal pose
      Enabled: true
      Topic:
        Value: /parking/goal_pose
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Shape: Arrow
      Color: 255; 40; 220
      Shaft Length: 1.2
      Head Length: 0.4
    - Class: rviz_default_plugins/MarkerArray
      Name: Parking slot lines
      Enabled: true
      Topic:
        Value: /parking/slot_lines
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/MarkerArray
      Name: Parking lines (detector)
      Enabled: true
      Topic:
        Value: /parking/lines
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Marker
      Name: Current vehicle
      Enabled: true
      Topic:
        Value: /parking/current_vehicle
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Show Names: true
      Show Axes: true
      Show Arrows: true
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top-down
      Scale: 25
      Angle: 0
      X: 0
      Y: 0
Window Geometry:
  Width: 1400
  Height: 900
