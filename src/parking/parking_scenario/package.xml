<?xml version="1.0"?>
<package format="3">
  <name>parking_scenario</name>
  <version>0.1.0</version>
  <description>Vision slots on LiDAR odometry, LiDAR occupancy check, goal pose, path, HUD view.</description>
  <maintainer email="jaehun@example.com">jaehun</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>parking_slot_interfaces</exec_depend>
  <exec_depend>parking_slot_mapping</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>velodyne_msgs</exec_depend>
  <exec_depend>vision_lane_interfaces</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
