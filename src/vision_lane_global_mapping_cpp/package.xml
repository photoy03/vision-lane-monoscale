<?xml version="1.0"?>
<package format="3">
  <name>vision_lane_global_mapping_cpp</name>
  <version>0.4.0</version>
  <description>Stage-1 timestamp-aligned MonoScale lane mapper; legacy V4L2 and CPU/CUDA preprocessing retained.</description>
  <maintainer email="jaehun@todo.todo">jaehun</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <exec_depend>rclpy</exec_depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>opencv</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <depend>vision_lane_interfaces</depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
